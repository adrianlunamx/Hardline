<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline" Width="1220" Height="840" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#EEF1F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!--HL:THEME-->
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <DockPanel Grid.Row="0" Margin="28,20,28,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="btnNews" Style="{StaticResource Ghost}" Margin="0,0,4,0" ToolTip="Qué hay de nuevo en Hardline">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" FontSize="14"/>
            <TextBlock Text="Novedades" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Ellipse x:Name="dotNews" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
        </Button>
        <Button x:Name="btnFolder" Style="{StaticResource Ghost}" Margin="0,0,12,0" ToolTip="Abrir la carpeta de Hardline (backups, reportes, registros)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14"/>
            <TextBlock Text="Carpeta" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="btnUpdate" Visibility="Collapsed" Style="{StaticResource Primary}" Content="Actualizar"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <Canvas Width="44" Height="44">
          <Rectangle Width="44" Height="44" RadiusX="12" RadiusY="12" Fill="#12161E" Stroke="#2E3746"/>
          <Polyline Points="6,22 9,22 10.5,13 12,30 14,16 15.5,27 17,19 18.5,24 20,21 21.5,23 23,22" Stroke="#5B6472"
                    StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line X1="23" Y1="22" X2="36" Y2="22" Stroke="#FF5A1F" StrokeThickness="3.5" StrokeStartLineCap="Round"/>
          <Ellipse Canvas.Left="33" Canvas.Top="19" Width="6.5" Height="6.5" Fill="#FF5A1F"/>
        </Canvas>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="HARDLINE" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Bold"/>
            <Border Style="{StaticResource Chip}" Margin="10,2,0,0">
              <TextBlock x:Name="txtVersion" Text="v" FontSize="11" Foreground="{StaticResource Muted}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Optimizaciones medibles para Warzone" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="28,0,28,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="410"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Columna izquierda: qué aplicar -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
          <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradient}" Padding="20">
            <StackPanel>
              <TextBlock Text="Optimizar" Style="{StaticResource H1}"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,16"
                         Text="Elige qué ajustar y pulsa Aplicar. Se crea un punto de restauración y cada cambio se puede revertir."/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnApply" Grid.Column="0" Style="{StaticResource Primary}" Padding="18,12" FontSize="14">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Aplicar" Margin="10,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button x:Name="btnDryRun" Grid.Column="2" Padding="16,12" Content="Simular" ToolTip="Muestra lo que haría sin cambiar nada."/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="MÓDULOS" Style="{StaticResource Section}"/>
              <CheckBox x:Name="chkWindows" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE770;" Width="28"/>
                  <StackPanel><TextBlock Text="Windows" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Servicios, registro, energía y timer"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkDisplay" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Width="28"/>
                  <StackPanel><TextBlock Text="Pantalla" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Refresco máximo, ventana y overlays"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkPlatforms" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Width="28"/>
                  <StackPanel><TextBlock Text="Plataformas de juego" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Battle.net, Steam, Xbox"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkSession" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Width="28"/>
                  <StackPanel><TextBlock Text="Modo partida" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Pausa lo innecesario solo con Warzone abierto"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkLatency" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" Width="28"/>
                  <StackPanel><TextBlock Text="Latencia avanzada" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Modo MSI e interrupciones de la NIC"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkNetwork" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Width="28"/>
                  <StackPanel><TextBlock Text="Red" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="DNS, ahorro de energía de la NIC, QoS"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkNetDiag" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Width="28"/>
                  <StackPanel><TextBlock Text="Diagnóstico de red" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Pérdida, jitter, bufferbloat (~40 s)"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkGame" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Width="28"/>
                  <StackPanel><TextBlock Text="Warzone" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Ajustes gráficos del juego"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkController" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Width="28"/>
                  <StackPanel><TextBlock Text="Mando" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Energía USB, capas de remapeo, ajustes"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkAudio" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" Width="28"/>
                  <StackPanel><TextBlock Text="Audio" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="EQ de pasos y compresor"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkBench" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Width="28"/>
                  <StackPanel><TextBlock Text="Benchmark" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="Antes y después, para comparar"/></StackPanel>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkExperimental" IsChecked="False"
                        ToolTip="disabledynamictick, colas de ratón/teclado, Win32PrioritySeparation. Mide antes/después y revierte si no notas nada.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Width="28" Foreground="{StaticResource Warn}"/>
                  <StackPanel><TextBlock Text="Experimental" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/><TextBlock Style="{StaticResource Caption}" Text="Evidencia débil: mide antes y después"/></StackPanel>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,14">
            <StackPanel>
              <TextBlock Text="OPCIONES" Style="{StaticResource Section}"/>
              <TextBlock Text="Plataforma de Warzone" Style="{StaticResource Label}" Margin="0,0,0,5"/>
              <ComboBox x:Name="cmbPlatform" SelectedIndex="0">
                <ComboBoxItem Content="Detectar automáticamente" Tag=""/>
                <ComboBoxItem Content="Battle.net" Tag="battlenet"/>
                <ComboBoxItem Content="Steam" Tag="steam"/>
                <ComboBoxItem Content="Xbox app / Game Pass" Tag="xbox"/>
              </ComboBox>
              <CheckBox x:Name="chkDisableOthers" IsChecked="False" Margin="0,10,0,0"
                        ToolTip="Cierra sus procesos, quita su arranque automático y deshabilita sus servicios. Desactivado: se conservan.">
                <TextBlock Text="Cerrar las otras plataformas instaladas" TextWrapping="Wrap"/>
              </CheckBox>

              <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,4"/>
              <TextBlock Text="Headset (vacío = detectar)" Style="{StaticResource Label}"/>
              <TextBox x:Name="txtHeadset"
                       ToolTip="Id incluido (hyperx-cloud-ii...), un archivo de la carpeta headsets o cualquier modelo para buscar en AutoEq (ej. Kraken V3)."/>

              <TextBlock Text="Modo de audio" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbAudioMode" SelectedIndex="0">
                <ComboBoxItem Content="Completo: EQ + compresor (+10-20 ms)" Tag="Full"/>
                <ComboBoxItem Content="Solo EQ (sin latencia añadida)" Tag="EqOnly"/>
              </ComboBox>

              <TextBlock Text="Salida del headset (Voicemeeter A1)" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbOutput"/>

              <TextBlock Text="Compresor (Voicemeeter)" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbDynamics" SelectedIndex="0">
                <ComboBoxItem Content="Mantener el actual" Tag=""/>
                <ComboBoxItem Content="Suave: casi natural, solo recorta los picos" Tag="suave"/>
                <ComboBoxItem Content="Normal: explosiones controladas" Tag="normal"/>
                <ComboBoxItem Content="Fuerte: disparos y explosiones muy bajos" Tag="pasos"/>
                <ComboBoxItem Content="Rush: para tiroteos seguidos" Tag="rush"/>
              </ComboBox>

              <TextBlock Text="Intensidad del EQ" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbIntensity" SelectedIndex="0">
                <ComboBoxItem Content="Completa" Tag="1.0"/>
                <ComboBoxItem Content="Moderada (70%)" Tag="0.7"/>
              </ComboBox>
              <CheckBox x:Name="chkCleanAudio" IsChecked="True" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Quitar el audio personalizado anterior" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Text="Art Tune, Peace, FxSound, Boom 3D... Su configuración siempre se aparta (revertible)."/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="chkHeSuVi" IsChecked="False" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="HeSuVi: 7.1 virtual para audífonos" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" Text="Sobre Equalizer APO. La guía te abre el panel para poner el headset en 7.1."/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Columna derecha: guía, herramientas y actividad -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Guía de pasos" Style="{StaticResource H2}"/>
                  <TextBlock x:Name="txtGuideSummary" Style="{StaticResource Caption}" Text="Lo que Hardline no puede hacer por ti"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="btnGuide" Content="Abrir guía"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Audio" Style="{StaticResource H2}"/>
                  <TextBlock Style="{StaticResource Caption}" Text="EQ, compresor y novedades"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="btnEqPanel" Content="Hardline EQ" Margin="0,0,8,0"/>
                <Button x:Name="btnFootstep" Content="Test de pasos"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
          <TextBlock Text="HERRAMIENTAS" Style="{StaticResource Section}"/>
          <UniformGrid Columns="3" Margin="0,0,-10,0">
            <Button x:Name="btnGameplay" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Medir partida" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="FPS y 1% lows reales"/>
              </StackPanel>
            </Button>
            <Button x:Name="btnBench" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Benchmark" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="Compara con el anterior"/>
              </StackPanel>
            </Button>
            <Button x:Name="btnNetDiag" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Diagnóstico de red" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="Pérdida, jitter, bufferbloat"/>
              </StackPanel>
            </Button>
            <Button x:Name="btnControllerTest" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Test de mando" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="Drift y zona muerta mínima"/>
              </StackPanel>
            </Button>
            <Button x:Name="btnReport" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{StaticResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock Text="Último reporte" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="Qué se cambió y por qué"/>
              </StackPanel>
            </Button>
            <Button x:Name="btnRollback" Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Foreground="{StaticResource Danger}" HorizontalAlignment="Left"/>
                <TextBlock Text="Revertir todo" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Caption}" Text="Deja Windows como estaba"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="20,18,20,12">
              <DockPanel>
                <Button x:Name="btnLogToggle" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Ocultar registro" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="ACTIVIDAD" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                  <TextBlock x:Name="txtPhase" Text="Listo" Style="{StaticResource H2}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="txtStatus" Text="Elige qué ajustar y pulsa Simular para ver qué haría, o Aplicar." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
              <ProgressBar x:Name="prgBusy" Margin="0,14,0,0" IsIndeterminate="False" Value="0"/>
            </StackPanel>

            <UniformGrid x:Name="pnlStats" Grid.Row="1" Columns="3" Margin="20,0,10,14" Visibility="Collapsed">
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock x:Name="txtStatApplied" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                  <TextBlock Text="cambios aplicados" Style="{StaticResource Caption}"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock x:Name="txtStatManual" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                  <TextBlock x:Name="txtStatManualLabel" Text="pasos nuevos en la guía" Style="{StaticResource Caption}"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock x:Name="txtStatFailed" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                  <TextBlock Text="fallos" Style="{StaticResource Caption}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border x:Name="brdLog" Grid.Row="2" Background="#090B0F" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
              <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                       Foreground="#AEB6C4" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="10,8"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       Text="Aquí aparece lo que va haciendo Hardline."/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Margin="28,12,28,16">
      <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                 Text="Todo cambio queda en el manifiesto de la sesión y se deshace con «Revertir todo». Algunos ajustes (HAGS, modo MSI, timer, servicios) necesitan reiniciar."/>
    </Border>
  </Grid>
</Window>
