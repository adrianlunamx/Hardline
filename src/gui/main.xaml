<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0E1116" Foreground="#E6EAF0"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#161B22"/>
    <SolidColorBrush x:Key="Line" Color="#2A313C"/>
    <SolidColorBrush x:Key="Muted" Color="#8A93A3"/>
    <SolidColorBrush x:Key="Accent" Color="#FF5A1F"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6EAF0"/>
      <Setter Property="Background" Value="#1F2630"/>
      <Setter Property="BorderBrush" Value="#2A313C"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF5A1F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF5A1F"/>
      <Setter Property="BorderBrush" Value="#FF5A1F"/>
      <Setter Property="Foreground" Value="#0E1116"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EAF0"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Label">
      <Setter Property="Foreground" Value="#8A93A3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Section">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A93A3"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Columna izquierda: qué aplicar -->
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
        <Canvas Width="44" Height="44">
          <Rectangle Width="44" Height="44" RadiusX="10" RadiusY="10" Fill="#161B22" Stroke="#2A313C"/>
          <Polyline Points="6,22 9,22 10.5,13 12,30 14,16 15.5,27 17,19 18.5,24 20,21 21.5,23 23,22" Stroke="#5B6472"
                    StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line X1="23" Y1="22" X2="36" Y2="22" Stroke="#FF5A1F" StrokeThickness="3.5" StrokeStartLineCap="Round"/>
          <Ellipse Canvas.Left="33" Canvas.Top="19" Width="6.5" Height="6.5" Fill="#FF5A1F"/>
        </Canvas>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="HARDLINE" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="txtVersion" Text="v" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <Button x:Name="btnUpdate" Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center" Content="Actualizar" Style="{StaticResource Primary}"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="MÓDULOS" Style="{StaticResource Section}"/>
              <CheckBox x:Name="chkWindows" IsChecked="True" Content="Windows: servicios, registro, energía, timer"/>
              <CheckBox x:Name="chkDisplay" IsChecked="True" Content="Pantalla: refresco máximo, ventana, overlays"/>
              <CheckBox x:Name="chkPlatforms" IsChecked="True" Content="Plataformas de juego"/>
              <CheckBox x:Name="chkSession" IsChecked="True" Content="Modo partida"/>
              <CheckBox x:Name="chkLatency" IsChecked="True" Content="Latencia avanzada: modo MSI, NIC"/>
              <CheckBox x:Name="chkNetwork" IsChecked="True" Content="Red: DNS, ahorro de energía NIC, QoS"/>
              <CheckBox x:Name="chkNetDiag" IsChecked="True" Content="Diagnóstico de red (~40 s)"/>
              <CheckBox x:Name="chkGame" IsChecked="True" Content="Warzone: ajustes gráficos"/>
              <CheckBox x:Name="chkController" IsChecked="True" Content="Mando: energía USB, capas de remapeo, ajustes"/>
              <CheckBox x:Name="chkAudio" IsChecked="True" Content="Audio: EQ de pasos y compresor"/>
              <CheckBox x:Name="chkBench" IsChecked="True" Content="Benchmark antes/después"/>
              <CheckBox x:Name="chkExperimental" IsChecked="False" Foreground="#D29922"
                        Content="Experimental (evidencia débil)"
                        ToolTip="disabledynamictick, colas de ratón/teclado, Win32PrioritySeparation. Mide antes/después y revierte si no notas nada."/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
              <TextBlock Text="OPCIONES" Style="{StaticResource Section}"/>
              <TextBlock Text="Plataforma de Warzone" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbPlatform" SelectedIndex="0">
                <ComboBoxItem Content="Detectar automáticamente" Tag=""/>
                <ComboBoxItem Content="Battle.net" Tag="battlenet"/>
                <ComboBoxItem Content="Steam" Tag="steam"/>
                <ComboBoxItem Content="Xbox app / Game Pass" Tag="xbox"/>
              </ComboBox>
              <CheckBox x:Name="chkDisableOthers" IsChecked="False" Margin="0,8,0,0"
                        Content="Cerrar las otras plataformas instaladas"
                        ToolTip="Cierra sus procesos, quita su arranque automático y deshabilita sus servicios. Desmarcado: se conservan."/>

              <TextBlock Text="Headset (vacío = detectar)" Style="{StaticResource Label}"/>
              <TextBox x:Name="txtHeadset" Padding="6,4" Background="#0E1116" Foreground="#E6EAF0" BorderBrush="#2A313C"
                       ToolTip="Id incluido (hyperx-cloud-ii...), un archivo de la carpeta headsets o cualquier modelo para buscar en AutoEq (ej. Kraken V3)."/>

              <TextBlock Text="Modo de audio" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbAudioMode" SelectedIndex="0">
                <ComboBoxItem Content="Completo: EQ + compresor (+10-20 ms)" Tag="Full"/>
                <ComboBoxItem Content="Solo EQ (sin latencia añadida)" Tag="EqOnly"/>
              </ComboBox>

              <TextBlock Text="Salida del headset (Voicemeeter A1)" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbOutput"/>

              <TextBlock Text="Compresor (Voicemeeter)" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbDynamics" SelectedIndex="0">
                <ComboBoxItem Content="Mantener el actual" Tag=""/>
                <ComboBoxItem Content="Normal: explosiones controladas" Tag="normal"/>
                <ComboBoxItem Content="Pasos al máximo: disparos y explosiones muy bajos" Tag="pasos"/>
              </ComboBox>

              <TextBlock Text="Intensidad del EQ" Style="{StaticResource Label}"/>
              <ComboBox x:Name="cmbIntensity" SelectedIndex="0">
                <ComboBoxItem Content="Completa" Tag="1.0"/>
                <ComboBoxItem Content="Moderada (70%)" Tag="0.7"/>
              </ComboBox>
              <CheckBox x:Name="chkCleanAudio" IsChecked="True" Margin="0,10,0,0">
                <TextBlock TextWrapping="Wrap" Text="Si hay un audio personalizado anterior (Peace, FxSound, Boom 3D...), desinstalarlo antes. Su configuración siempre se aparta (revertible)."/>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Columna derecha: acciones y salida -->
    <DockPanel Grid.Column="2">
      <WrapPanel DockPanel.Dock="Top">
        <Button x:Name="btnApply" Content="Aplicar" Style="{StaticResource Primary}"/>
        <Button x:Name="btnGameplay" Content="Medir partida"/>
        <Button x:Name="btnGuide" Content="Guía de pasos"/>
        <Button x:Name="btnDryRun" Content="Simular (DryRun)"/>
        <Button x:Name="btnRollback" Content="Revertir todo"/>
        <Button x:Name="btnNetDiag" Content="Diagnóstico de red"/>
        <Button x:Name="btnBench" Content="Benchmark"/>
        <Button x:Name="btnFootstep" Content="Test de pasos"/>
        <Button x:Name="btnEqPanel" Content="Panel del EQ"/>
        <Button x:Name="btnControllerTest" Content="Test de mando"/>
        <Button x:Name="btnReport" Content="Abrir último reporte"/>
        <Button x:Name="btnFolder" Content="Carpeta de Hardline"/>
      </WrapPanel>

      <Grid DockPanel.Dock="Top" Margin="0,4,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="txtStatus" Grid.Column="0" Text="Listo." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <ProgressBar x:Name="prgBusy" Grid.Column="1" Height="6" IsIndeterminate="False" Foreground="#FF5A1F" Background="#161B22" BorderThickness="0"/>
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                 Text="Todo cambio queda en el manifiesto de la sesión y se deshace con «Revertir». Algunos ajustes (HAGS, modo MSI, timer, servicios) necesitan reiniciar."/>

      <Border Background="#0B0E12" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
        <TextBox x:Name="txtLog" IsReadOnly="True" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                 Foreground="#C4CAD4" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Text="Elige qué aplicar a la izquierda y pulsa «Simular» para ver qué haría sin cambiar nada, o «Aplicar»."/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
