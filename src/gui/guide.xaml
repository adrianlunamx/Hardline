<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline - guía de pasos" Width="720" Height="500" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#0B0D12" Foreground="#EEF1F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!--HL:THEME-->
  </Window.Resources>

  <DockPanel Margin="24,20,24,20">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
          <TextBlock x:Name="gCount" Foreground="{StaticResource Muted}" FontSize="11"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="gMode" Text="GUÍA DE PASOS" Style="{StaticResource Section}" Margin="0,0,0,4"/>
          <TextBlock x:Name="gPhase" Style="{StaticResource H1}" FontSize="20"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="gHint" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
      <ProgressBar x:Name="gProgress" Minimum="0" Maximum="1" Foreground="{StaticResource Ok}"/>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="gList" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Content="Ver lista completa"/>
      <Button x:Name="gDone" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Hecho" Margin="8,0,0,0" MinWidth="110"/>
      <Button x:Name="gSkip" DockPanel.Dock="Right" Content="Saltar" Margin="8,0,0,0"/>
      <Button x:Name="gPrev" DockPanel.Dock="Right" Content="Anterior"/>
    </DockPanel>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,20">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}">
              <TextBlock x:Name="gArea" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
            </Border>
            <Border x:Name="gNew" Style="{StaticResource Chip}" Background="{StaticResource Accent}" Margin="8,0,0,0" Visibility="Collapsed">
              <TextBlock Text="NUEVO" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="gState" Foreground="{StaticResource Ok}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="gText" FontSize="16" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="24"/>
          <WrapPanel Margin="0,18,0,0">
            <Button x:Name="gAction" Margin="0,0,8,8" Padding="14,9" BorderBrush="{StaticResource Accent}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="gActionText" Text="Abrir" Margin="9,0,0,0" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button x:Name="gLink" Margin="0,0,8,8" Padding="14,9">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="Abrir enlace" Margin="9,0,0,0"/>
              </StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock x:Name="gActionHint" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
