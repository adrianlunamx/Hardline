<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline - novedades" Width="560" Height="620" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#0B0D12" Foreground="#EEF1F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!--HL:THEME-->
  </Window.Resources>

  <DockPanel Margin="24,20,24,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="NOVEDADES" Style="{StaticResource Section}" Margin="0,0,0,4"/>
      <TextBlock Text="Qué ha cambiado en Hardline" Style="{StaticResource H1}" FontSize="20"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
      <Button x:Name="newsClose" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Cerrar" Padding="18,8"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="newsList"/>
    </ScrollViewer>
  </DockPanel>
</Window>
