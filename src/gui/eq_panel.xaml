<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline EQ" Width="400" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#EEF1F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!--HL:THEME-->
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20,18,20,18">
    <DockPanel>
      <Button x:Name="btnNewsAll" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,4" ToolTip="Todas las novedades">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" FontSize="13"/>
          <TextBlock Text="Novedades" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal">
        <Canvas Width="30" Height="30">
          <Rectangle Width="30" Height="30" RadiusX="9" RadiusY="9" Fill="#0E1116" Stroke="#2E3746"/>
          <Rectangle Canvas.Left="6" Canvas.Top="6.38" Width="3.87" Height="17.25" RadiusX="1.12" RadiusY="1.12" Fill="#EEF1F6"/>
          <Rectangle Canvas.Left="17.13" Canvas.Top="6.38" Width="3.87" Height="17.25" RadiusX="1.12" RadiusY="1.12" Fill="#EEF1F6"/>
          <Rectangle Canvas.Left="6" Canvas.Top="13.12" Width="18.75" Height="3.75" RadiusX="1.88" RadiusY="1.88">
            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF5A1F" Offset="0"/><GradientStop Color="#FF9A3D" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
          </Rectangle>
          <Ellipse Canvas.Left="22.37" Canvas.Top="12.5" Width="5" Height="5" Fill="#FF5A1F"/>
          <Ellipse Canvas.Left="23.94" Canvas.Top="14.06" Width="1.88" Height="1.88" Fill="#0E1116"/>
        </Canvas>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="HARDLINE EQ" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="EQ de pasos y compresor" Style="{StaticResource Caption}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Novedades y avisos: aparece solo si hay algo sin ver. -->
    <Border x:Name="newsCard" Margin="0,16,0,0" CornerRadius="14" BorderThickness="1" BorderBrush="#66FF5A1F"
            Background="{StaticResource HeroGradient}" Padding="16,14" Visibility="Collapsed">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="newsCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/>
          <Border Style="{StaticResource Chip}" Background="{StaticResource Accent}" HorizontalAlignment="Left">
            <TextBlock x:Name="newsBadge" Text="NOVEDADES" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
          </Border>
        </DockPanel>
        <TextBlock x:Name="newsTitle" Style="{StaticResource H2}" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="newsDate" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"/>
        <StackPanel x:Name="newsItems" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="newsOk" Style="{StaticResource Primary}" Content="Entendido" Padding="16,7"/>
          <Button x:Name="newsMore" Style="{StaticResource Ghost}" Content="Ver todas" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Estado y encendido -->
    <Border x:Name="eqBadge" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="EQ DE PASOS" Style="{StaticResource Section}" Margin="0,0,0,2"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="eqDot" Width="11" Height="11" Fill="#8B94A5" VerticalAlignment="Center"/>
            <TextBlock x:Name="eqState" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Text="..." Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="eqDetail" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="eqToggle" Grid.Column="1" Content="Apagar" FontWeight="SemiBold" MinWidth="104" Padding="18,10" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Intensidad del EQ: 0-150 %, se aplica al soltar. -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
      <StackPanel>
        <Grid>
          <TextBlock Text="INTENSIDAD DEL EQ" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
          <TextBlock x:Name="eqIntValue" Style="{StaticResource BigValue}" Text="100 %"/>
        </Grid>
        <Slider x:Name="eqIntSlider" Style="{StaticResource HLSlider}" Minimum="0" Maximum="150" SmallChange="5" LargeChange="10"
                TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="100" Margin="0,8,0,0"/>
        <!-- 100 % cae a 2/3 del recorrido (0-150). El tirador mide 20: 10 px de margen a cada lado. -->
        <Grid Margin="10,2,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="0 %" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
          <TextBlock Grid.Column="1" Text="100 %" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-14,0,0,0"/>
          <TextBlock Grid.Column="1" Text="150" Style="{StaticResource Tick}" HorizontalAlignment="Right" Margin="0,0,-8,0"/>
        </Grid>
        <TextBlock x:Name="eqIntHint" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <!-- Compresor: cuatro niveles, de menos a más. -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
      <StackPanel>
        <Grid>
          <TextBlock Text="COMPRESOR (VOICEMEETER)" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
          <TextBlock x:Name="eqDynValue" Style="{StaticResource BigValue}" Text="Normal"/>
        </Grid>
        <Slider x:Name="eqDynSlider" Style="{StaticResource HLSlider}" Minimum="0" Maximum="3" SmallChange="1" LargeChange="1"
                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="1" Margin="0,8,0,0"/>
        <!-- Marcas a 0, 1/3, 2/3 y 1 del recorrido. -->
        <Grid Margin="10,2,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Suave" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
          <TextBlock Grid.Column="1" Text="Normal" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-18,0,0,0"/>
          <TextBlock Grid.Column="2" Text="Fuerte" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-16,0,0,0"/>
          <TextBlock Grid.Column="2" Text="Rush" Style="{StaticResource Tick}" HorizontalAlignment="Right" Margin="0,0,-12,0"/>
        </Grid>
        <TextBlock x:Name="eqDynHint" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="eqTest" HorizontalContentAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="Test de pasos" Margin="9,0,0,0"/>
        </StackPanel>
      </Button>
      <Button x:Name="eqReset" Grid.Column="2" Content="Restablecer" ToolTip="Intensidad 100 % y compresor Normal"/>
    </Grid>

    <CheckBox x:Name="eqTopmost" Margin="2,14,2,0">
      <TextBlock Text="Siempre visible"/>
    </CheckBox>
    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" Margin="2,10,2,0"
               Text="En partida: Ctrl+Alt+F10 enciende o apaga el EQ (un pitido agudo = encendido, dos graves = apagado). Todo se aplica al momento, sin reiniciar el audio."/>
  </StackPanel>
  </ScrollViewer>
</Window>
