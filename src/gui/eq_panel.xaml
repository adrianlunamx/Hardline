<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline EQ" Width="440" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0E1116" Foreground="#E6EAF0"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8A93A3"/>
    <SolidColorBrush x:Key="Card" Color="#161B22"/>
    <SolidColorBrush x:Key="Line" Color="#2A313C"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6EAF0"/>
      <Setter Property="Background" Value="#1F2630"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF5A1F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Deslizador: pista gris, tramo recorrido en naranja, tirador redondo. -->
    <Style x:Key="HLSlider" TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="26" Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="#2A313C" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="#FF5A1F"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="20" Height="20">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#E6EAF0" Stroke="#FF5A1F" StrokeThickness="4"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tick" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF5A1F"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,18,20,18">
    <!-- Cabecera: estado y encendido -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="HARDLINE EQ" Style="{StaticResource CardTitle}" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Ellipse x:Name="eqDot" Width="12" Height="12" Fill="#8A93A3" VerticalAlignment="Center"/>
          <TextBlock x:Name="eqState" FontSize="24" FontWeight="SemiBold" Text="..." Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="eqDetail" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
      <Button x:Name="eqToggle" Grid.Column="1" Content="Apagar" FontWeight="SemiBold" MinWidth="110" Padding="18,10" VerticalAlignment="Center"/>
    </Grid>

    <!-- Intensidad del EQ -->
    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
      <StackPanel>
        <Grid>
          <TextBlock Text="INTENSIDAD DEL EQ DE PASOS" Style="{StaticResource CardTitle}"/>
          <TextBlock x:Name="eqIntValue" Style="{StaticResource BigValue}" Text="100 %"/>
        </Grid>
        <Slider x:Name="eqIntSlider" Style="{StaticResource HLSlider}" Minimum="0" Maximum="150" SmallChange="5" LargeChange="10"
                TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="100" Margin="0,8,0,0"/>
        <!-- 100 % cae a 2/3 del recorrido (0-150). El tirador mide 20: 10 px de margen a cada lado. -->
        <Grid Margin="10,2,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="0 %" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
          <TextBlock Grid.Column="1" Text="100 % · completo" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-16,0,0,0"/>
          <TextBlock Grid.Column="1" Text="150" Style="{StaticResource Tick}" HorizontalAlignment="Right" Margin="0,0,-8,0"/>
        </Grid>
        <TextBlock x:Name="eqIntHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <!-- Compresor -->
    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
      <StackPanel>
        <Grid>
          <TextBlock Text="COMPRESOR (VOICEMEETER)" Style="{StaticResource CardTitle}"/>
          <TextBlock x:Name="eqDynValue" Style="{StaticResource BigValue}" Text="Normal"/>
        </Grid>
        <Slider x:Name="eqDynSlider" Style="{StaticResource HLSlider}" Minimum="0" Maximum="3" SmallChange="1" LargeChange="1"
                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="1" Margin="0,8,0,0"/>
        <!-- Cuatro marcas a 0, 1/3, 2/3 y 1 del recorrido. -->
        <Grid Margin="10,2,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Suave" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
          <TextBlock Grid.Column="1" Text="Normal" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-18,0,0,0"/>
          <TextBlock Grid.Column="2" Text="Fuerte" Style="{StaticResource Tick}" HorizontalAlignment="Left" Margin="-16,0,0,0"/>
          <TextBlock Grid.Column="2" Text="Rush" Style="{StaticResource Tick}" HorizontalAlignment="Right" Margin="0,0,-12,0"/>
        </Grid>
        <TextBlock x:Name="eqDynHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <!-- Acciones -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="eqTest" Content="Test de pasos (EQ apagado y encendido)"/>
      <CheckBox x:Name="eqTopmost" Grid.Column="1" Foreground="#E6EAF0" Margin="14,0,0,0" VerticalAlignment="Center" Content="Siempre visible"/>
    </Grid>
    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
               Text="En partida: Ctrl+Alt+F10 enciende o apaga el EQ (un pitido agudo = encendido, dos graves = apagado). Todo se aplica al momento, sin reiniciar el audio."/>
  </StackPanel>
</Window>
