<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardline EQ" Width="360" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#0E1116" Foreground="#E6EAF0"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6EAF0"/>
      <Setter Property="Background" Value="#1F2630"/>
      <Setter Property="BorderBrush" Value="#2A313C"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF5A1F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock Text="EQ DE PASOS" Foreground="#8A93A3" FontSize="12" FontWeight="SemiBold"/>
    <Border x:Name="eqBadge" CornerRadius="8" Padding="14,12" Margin="0,8,0,0" Background="#161B22" BorderBrush="#2A313C" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="eqState" FontSize="26" FontWeight="SemiBold" Text="..."/>
        <TextBlock x:Name="eqDetail" Foreground="#8A93A3" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <Button x:Name="eqToggle" Margin="0,12,0,0" Content="Apagar" FontWeight="SemiBold"/>

    <TextBlock Text="Intensidad" Foreground="#8A93A3" FontSize="12" Margin="0,14,0,4"/>
    <ComboBox x:Name="eqIntensity"/>

    <TextBlock Text="Compresor (Voicemeeter)" Foreground="#8A93A3" FontSize="12" Margin="0,14,0,4"/>
    <ComboBox x:Name="eqDynamics">
      <ComboBoxItem Content="Normal: explosiones controladas" Tag="normal"/>
      <ComboBoxItem Content="Pasos al máximo: disparos y explosiones muy bajos" Tag="pasos"/>
    </ComboBox>
    <TextBlock x:Name="eqDynHint" Foreground="#8A93A3" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>

    <Button x:Name="eqTest" Margin="0,12,0,0" Content="Test de pasos (EQ apagado y encendido)"/>
    <CheckBox x:Name="eqTopmost" Foreground="#E6EAF0" Margin="0,12,0,0" Content="Siempre visible"/>
    <TextBlock Foreground="#8A93A3" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
               Text="En partida: Ctrl+Alt+F10 (un pitido agudo = encendido, dos graves = apagado). El cambio se aplica al momento, sin reiniciar el audio."/>
  </StackPanel>
</Window>
